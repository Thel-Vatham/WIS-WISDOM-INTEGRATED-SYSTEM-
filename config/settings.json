{
    "llm": {
        "base_url": "https://api.deepseek.com",
        "api_key": "",
        "model": "deepseek-chat",
        "fallback_model": "deepseek-chat",
        "temperature": 0.7
    },
    "memory": {
        "db_path": "Data/wis_memory.db",
        "history_limit": 20
    },
    "voice": {
        "enabled": true,
        "rate": 170,
        "language": "en",
        "voice_name": "en-US-JennyNeural"
    },
    "security": {
        "mode": "privileged"
    },
    "agentic": {
        "max_steps": 10,
        "step_timeout_s": 60
    },
    "proactivity": {
        "enabled": true,
        "check_interval_s": 60
    },
    "system_ability": {
        "mode": "autonomous",
        "extra_allowed": []
    },
    "server": {
        "host": "127.0.0.1",
        "port": 7777,
        "console_token": "",
        "cors_origins": []
    }
}